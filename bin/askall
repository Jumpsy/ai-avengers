#!/usr/bin/env bash
# askall [--buffer <name>] | <prompt...>
# Broadcast a prompt into EVERY agent pane in the session, RELIABLY.
# Types into all panes, submits all, then verifies each pane received it and
# retries the ones that didn't (handles agents that were busy/rendering).
sess="${ASK_SESSION:-$(tmux display-message -p '#{session_name}' 2>/dev/null)}"
[ -z "$sess" ] && sess=agents

if [ "$1" = "--buffer" ]; then
  buf="${2:-bcast}"
  p="$(tmux show-buffer -b "$buf" 2>/dev/null)"
  tmux delete-buffer -b "$buf" 2>/dev/null
else
  p="$*"
fi
[ -z "$p" ] && { echo "usage: askall <prompt>   (broadcasts to all agent panes in session '$sess')"; exit 1; }

FROM="${AGENT_NAME:-user}"
msg="[$FROM says] $p"
S="${AGENT_SHARED:-$HOME/agent-shared}/conversation.log"; mkdir -p "$(dirname "$S")"
printf '[%s] %s -> ALL: %s\n' "$(date -u +%H:%M:%S)" "$FROM" "$p" >> "$S"

panes=$(tmux list-panes -t "$sess" -F '#{pane_id} #{@agent}' 2>/dev/null | awk '$2!=""{print $1}')
[ -z "$panes" ] && { echo "no agent panes found in session '$sess'"; exit 1; }

# send the prompt into one pane: clear any stale input, type, settle, submit
send_one() {
  local pane="$1"
  tmux send-keys -t "$pane" C-u 2>/dev/null      # clear current input line
  tmux send-keys -t "$pane" -l "$msg"            # type the literal message
  sleep 0.4                                      # let the TUI place it in its input box
  tmux send-keys -t "$pane" Enter                # submit
}

# did this pane actually receive the message? (look for our line in recent output)
got_it() { tmux capture-pane -p -J -S -60 -t "$1" 2>/dev/null | grep -qF "$msg"; }

# pass 1
for pane in $panes; do send_one "$pane"; done

# verify + up to 2 retries for any pane that didn't take it
ok=""; missing="$panes"
for attempt in 1 2 3; do
  sleep 1.2
  still=""
  for pane in $missing; do
    if got_it "$pane"; then ok="$ok $pane"; else still="$still $pane"; fi
  done
  missing="$(echo $still)"
  [ -z "$missing" ] && break
  for pane in $missing; do send_one "$pane"; done
done

total=$(printf '%s\n' $panes | wc -l | tr -d ' ')
if [ -n "$missing" ]; then
  for pane in $missing; do
    a=$(tmux display-message -p -t "$pane" '#{@agent}')
    echo "⚠ $a ($pane) may not have received it — it could be mid-task; try again or check that pane."
  done
fi
echo "📣 broadcast to $total agents (confirmed delivered to $(echo $ok | wc -w | tr -d ' ')): $p"
