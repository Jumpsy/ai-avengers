#!/usr/bin/env bash
# remember "<durable fact>"   save a fact shared by all agents, persists across restarts
M="${AGENT_SHARED:-$HOME/agent-shared}/memory/MEMORY.md"; mkdir -p "$(dirname "$M")"
[ -z "$*" ] && { echo "usage: remember <durable fact>"; exit 1; }
printf -- '- [%s] (%s) %s\n' "$(date -u +%Y-%m-%dT%H:%M)" "${AGENT_NAME:-agent}" "$*" >> "$M"
echo "remembered."
